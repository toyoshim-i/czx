ROOT_DIR ?= $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/../..)
CZX_DIR  := $(ROOT_DIR)/cmake/efm7_czx
CSCP_SRC := $(ROOT_DIR)/third_party/takeda-cscp-emulators/src

FM7_MODEL ?= FM7

ifeq ($(FM7_MODEL),FM7)
MODEL_DEF       := -D_FM7
MODEL_SRCS      :=
MODEL_WRAP_SRCS :=
DEFAULT_SO := $(ROOT_DIR)/build/cores/efm7_libretro.so
DEFAULT_OB := $(ROOT_DIR)/build/cores-efm7
else ifeq ($(FM7_MODEL),FM77AV)
MODEL_DEF       := -D_FM77AV
MODEL_SRCS      := vm/beep.cpp vm/fm7/mb61vh010.cpp
MODEL_WRAP_SRCS :=
DEFAULT_SO := $(ROOT_DIR)/build/cores/efm77av_libretro.so
DEFAULT_OB := $(ROOT_DIR)/build/cores-efm77av
else ifeq ($(FM7_MODEL),FM77AV40)
MODEL_DEF       := -D_FM77AV40
MODEL_SRCS      := vm/beep.cpp vm/fm7/mb61vh010.cpp
MODEL_WRAP_SRCS := hd6844_wrap.cpp
DEFAULT_SO := $(ROOT_DIR)/build/cores/efm77av40_libretro.so
DEFAULT_OB := $(ROOT_DIR)/build/cores-efm77av40
else
$(error Unsupported FM7_MODEL '$(FM7_MODEL)'; expected FM7, FM77AV, or FM77AV40)
endif

OBJ_DIR  ?= $(DEFAULT_OB)
OUT_SO   ?= $(DEFAULT_SO)

CXX       ?= g++
OPT_FLAGS ?= -O3
LDFLAGS   ?=

CPPFLAGS_COMMON := \
	$(MODEL_DEF) \
	-D_USE_SDL \
	-D_RGB565 \
	-I$(CZX_DIR) \
	-I$(CSCP_SRC) \
	-I$(ROOT_DIR)/include

CXXFLAGS_COMMON := \
	-std=gnu++17 \
	$(OPT_FLAGS) \
	-fPIC \
	-fvisibility=hidden \
	-fno-gnu-unique

CXXFLAGS_UPSTREAM := \
	$(CXXFLAGS_COMMON) \
	-Wno-narrowing \
	-Wno-unused-parameter \
	-Wno-sign-compare \
	-Wno-format-truncation \
	-Wno-class-memaccess \
	-Wno-misleading-indentation \
	-Wno-unused-variable \
	-Wno-unused-but-set-variable \
	-Wno-unused-function \
	-Wno-write-strings

CXXFLAGS_CZX := \
	$(CXXFLAGS_COMMON) \
	-Wall -Wextra -Wno-unused-parameter

UPSTREAM_SRCS := \
	fifo.cpp \
	fileio.cpp \
	vm/and.cpp \
	vm/ay_3_891x.cpp \
	vm/datarec.cpp \
	vm/disk.cpp \
	vm/event.cpp \
	vm/i8251.cpp \
	vm/mb8877.cpp \
	vm/memory.cpp \
	vm/noise.cpp \
	vm/pcm1bit.cpp \
	vm/prnfile.cpp \
	vm/ym2203.cpp \
	vm/fmgen/fmgen.cpp \
	vm/fmgen/fmtimer.cpp \
	vm/fmgen/opna.cpp \
	vm/fmgen/psg.cpp \
	vm/fm7/display.cpp \
	vm/fm7/dummydevice.cpp \
	vm/fm7/floppy.cpp \
	vm/fm7/fm7.cpp \
	vm/fm7/fm7_mainio.cpp \
	vm/fm7/fm7_mainmem.cpp \
	vm/fm7/jcommcard.cpp \
	vm/fm7/joystick.cpp \
	vm/fm7/kanjirom.cpp \
	vm/fm7/keyboard.cpp \
	vm/fm7/mainmem_mmr.cpp \
	vm/fm7/mainmem_page2.cpp \
	vm/fm7/mainmem_readseq.cpp \
	vm/fm7/mainmem_utils.cpp \
	vm/fm7/mainmem_writeseq.cpp \
	vm/fm7/sound.cpp \
	vm/fm7/vram.cpp \
	$(MODEL_SRCS)

UPSTREAM_WRAP_SRCS := \
	mc6809_wrap.cpp \
	mc6809_base_wrap.cpp \
	$(MODEL_WRAP_SRCS)

CZX_SRCS := \
	common_wrap.cpp \
	libretro.cpp

OBJS := \
	$(patsubst %.cpp,$(OBJ_DIR)/upstream/%.o,$(UPSTREAM_SRCS)) \
	$(patsubst %.cpp,$(OBJ_DIR)/upstream_wrap/%.o,$(UPSTREAM_WRAP_SRCS)) \
	$(patsubst %.cpp,$(OBJ_DIR)/czx/%.o,$(CZX_SRCS))

.PHONY: all clean

all: $(OUT_SO)

$(OUT_SO): $(OBJS) $(CZX_DIR)/link.T
	@mkdir -p $(dir $@)
	$(CXX) -shared -o $@ $(OBJS) \
		-Wl,--version-script=$(CZX_DIR)/link.T \
		-Wl,--no-undefined \
		$(LDFLAGS) -lm -lpthread

$(OBJ_DIR)/upstream/%.o: $(CSCP_SRC)/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CPPFLAGS_COMMON) $(CXXFLAGS_UPSTREAM) -include $(CZX_DIR)/preinclude.h -c $< -o $@

$(OBJ_DIR)/upstream_wrap/%.o: $(CZX_DIR)/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CPPFLAGS_COMMON) $(CXXFLAGS_UPSTREAM) -include $(CZX_DIR)/preinclude.h -c $< -o $@

$(OBJ_DIR)/czx/%.o: $(CZX_DIR)/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CPPFLAGS_COMMON) $(CXXFLAGS_CZX) -Wno-write-strings -include $(CZX_DIR)/preinclude.h -c $< -o $@

clean:
	rm -rf $(OBJ_DIR) $(OUT_SO)
